<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Dev" constructor="DevexCapexSummaryPCF" version="1.1.1" display-name-key="DevexCapexSummaryPCF" description-key="DevexCapexSummaryPCF description" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!--
      MAIN DATASET - bound by the Canvas App to colFinatCostDataOptimized
      (the "Finat" typo in the collection name is intentional/legacy).
      Each row is one account, subaccount, or contract, linked into a tree via
      RowId/ParentId with a Type field of "account" | "subaccount" | "contract".
      Expected fields include: RowId, ParentId, Type, Number, Name, SubLabel,
      M1..M12 (monthly costs for the SELECTED year only - see StartYear),
      TotalCost / PlannedCost / ActualCost (ALL-YEARS totals computed in Canvas;
      the PCF must never derive these from M1..M12), M1Paid..M12Paid (paid
      flags, alias Month1Paid..), IsStandardContract, CostPaidBy (DevCo/SPV),
      DistributionType, HasComments / CommentTooltip and
      M1HasComments / M1CommentTooltip .. M12 (comment red dots + tooltips).
      DatasetParser.ts accepts many alias spellings for most of these fields.
    -->
    <data-set name="DevexCapexCostSummary" display-name-key="Devex_Capex_Cost_Summary">

    </data-set>
    <!--
      SECOND DATASET - bound by the Canvas App to colStandardContractOptionsForPCF.
      Lists the standard contracts that can still be added per subaccount.
      Expected fields: StandardContractId, SubaccountId (matched against the
      subaccount row's RowId in the main dataset), Name, AutoId.
      Canvas must remove already-created standard contracts from this dataset;
      when no option exists for a subaccount, the PCF renders no
      "Add Standard Contract" item at all in the Add dropdown.
    -->
    <data-set name="StandardContractOptions" display-name-key="Standard_Contract_Options">
    </data-set>

    <!-- Input Configuration Properties
      All inputs are bound from the Canvas App:
      - ShowPlannedCost: toggles the "Total Planned" / "Total Paid" columns.
      - StartYear: the year whose monthly costs the M1..M12 columns represent;
        Canvas rebuilds the dataset whenever the user changes the year.
      - ShowEmptyAccounts: when false, accounts/subaccounts without any visible
        cost are hidden (after the CostPaidByFilter is applied).
      - CostPaidByFilter: "Show All Cost" | "DevCo" | "SPV" - UI-only filter on
        contract rows; account/subaccount/grand totals are recalculated from the
        rows that stay visible.
      - Cluster1Date..Cluster6Date: cluster start dates from gblClusterDurations;
        drive the cluster timeline header drawn above the month columns.
    -->
    <property name="ShowPlannedCost" display-name-key="Show Planned Cost" description-key="Show planned and actual cost columns" of-type="TwoOptions" usage="input" required="true" />
    <property name="StartYear" display-name-key="Start Year" description-key="The year to display in the monthly header columns (e.g. 2026)" of-type="Whole.None" usage="input" required="true" />
    <property name="ShowEmptyAccounts" display-name-key="Show Empty Accounts" description-key="Show accounts and subaccounts without any visible cost" of-type="TwoOptions" usage="input" required="false" />
    <property name="CostPaidByFilter" display-name-key="Cost Paid By Filter" description-key="Show All Cost, DevCo, or SPV" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="CollapseResetKey" display-name-key="Collapse Reset Key" description-key="Bug 13472: change this value (on tab switch / screen OnVisible) to collapse all accounts and subaccounts" of-type="SingleLine.Text" usage="input" required="false" />
    
    <property name="Cluster1Date" display-name-key="Cluster 1 Date" description-key="Start date for Cluster 1" of-type="DateAndTime.DateOnly" usage="input" required="false" />
    <property name="Cluster2Date" display-name-key="Cluster 2 Date" description-key="Start date for Cluster 2" of-type="DateAndTime.DateOnly" usage="input" required="false" />
    <property name="Cluster3Date" display-name-key="Cluster 3 Date" description-key="Start date for Cluster 3" of-type="DateAndTime.DateOnly" usage="input" required="false" />
    <property name="Cluster4Date" display-name-key="Cluster 4 Date" description-key="Start date for Cluster 4" of-type="DateAndTime.DateOnly" usage="input" required="false" />
    <property name="Cluster5Date" display-name-key="Cluster 5 Date" description-key="Start date for Cluster 5" of-type="DateAndTime.DateOnly" usage="input" required="false" />
    <property name="Cluster6Date" display-name-key="Cluster 6 Date" description-key="Start date for Cluster 6" of-type="DateAndTime.DateOnly" usage="input" required="false" />

    <!-- Output Trigger Action Properties
      The PCF never talks to Dataverse. Instead, every user action sets exactly
      ONE of the trigger booleans below to true together with the relevant
      selected IDs, then calls notifyOutputChanged(). The Canvas App's OnChange
      reads the trigger, performs the real create/edit/delete/comment/patch
      against Dataverse, refreshes its collections, and rebinds the datasets.
      index.ts resets the trigger booleans right after getOutputs() is read so
      the next identical action still produces a change Canvas can observe.

      Trigger -> payload mapping:
      - AddTriggered: SelectedRecordId = subaccount RowId to add a cost under.
      - AddStandardContractTriggered: SelectedRecordId = subaccount RowId,
        SelectedStandardContractId = chosen standard assumption ID.
      - EditTriggered / DeleteTriggered / CommentTriggered:
        SelectedRecordId = contract RowId.
      - SetCostPaidUnpaidTriggered: SelectedCostContractId + SelectedCostYear +
        SelectedCostMonth (1-12) + SelectedCostPaid (the DESIRED new state);
        Canvas must locate the CAPEX Cost record and patch its paid flag.
    -->
    <property name="EditTriggered" display-name-key="Edit Triggered" description-key="True if Edit action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="CommentTriggered" display-name-key="Comment Triggered" description-key="True if Comment action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="DeleteTriggered" display-name-key="Delete Triggered" description-key="True if Delete action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="AddTriggered" display-name-key="Add Triggered" description-key="True if Add action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="AddStandardContractTriggered" display-name-key="Add Standard Contract Triggered" description-key="True if Add Standard Contract action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="SetCostPaidUnpaidTriggered" display-name-key="Set Cost Paid Unpaid Triggered" description-key="True if Set as paid/unpaid action is triggered" of-type="TwoOptions" usage="output" required="false" />
    <property name="SelectedRecordId" display-name-key="Selected Record ID" description-key="The GUID/ID of the selected record" of-type="SingleLine.Text" usage="output" required="false" />
    <property name="SelectedStandardContractId" display-name-key="Selected Standard Contract ID" description-key="The GUID/ID of the selected standard contract" of-type="SingleLine.Text" usage="output" required="false" />
    <property name="SelectedCostContractId" display-name-key="Selected Cost Contract ID" description-key="The GUID/ID of the contract for the selected monthly cost" of-type="SingleLine.Text" usage="output" required="false" />
    <property name="SelectedCostYear" display-name-key="Selected Cost Year" description-key="The selected monthly cost year" of-type="Whole.None" usage="output" required="false" />
    <property name="SelectedCostMonth" display-name-key="Selected Cost Month" description-key="The selected monthly cost month number" of-type="Whole.None" usage="output" required="false" />
    <property name="SelectedCostPaid" display-name-key="Selected Cost Paid" description-key="True when the selected monthly cost should be paid, false when unpaid" of-type="TwoOptions" usage="output" required="false" />
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/TableConnectedToDataversePCF.css" order="1" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <resx path="strings/TableConnectedToDataversePCF.1033.resx" version="1.0.0" />
      -->
    </resources>

   
  </control>
</manifest>














