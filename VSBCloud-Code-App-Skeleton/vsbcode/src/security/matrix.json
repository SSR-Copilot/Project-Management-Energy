  "roles": {
    "applicationAdministrator": {
      "name": "VSB - Application Administrator",
      "flag": "isApplicationAdministrator",
      "description": "Full master-data authority across all countries and technologies. The only role that may delete master data."
    },
    "controllerOwnData": {
      "name": "VSB - Controller Own Data",
      "flag": "isControllerOwnData",
      "description": "Maintains master data but may not delete it. Scope is the controller's own business unit."
    },
    "projectDataAllCountries": {
      "name": "VSB - Project Data All Countries",
      "flag": "isProjectDataAllCountries",
      "description": "Reads and writes project data in every country. Reads master data; never writes it."
    },
    "projectDataOwnCountry": {
      "name": "VSB - Project Data Own Country",
      "flag": null,
      "description": "Reads and writes project data inside its own business unit, which is the country. Reads master data; never writes it."
    },
    "projectManagerOwnProjects": {
      "name": "VSB - Project Manager Own Projects",
      "flag": "isProjectManagerOwnProjects",
      "description": "Reads and writes only the projects the user owns. Reads master data; never writes it."
    }
  },
