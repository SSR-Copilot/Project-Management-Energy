# Dataverse environment the code app is bound to.
# Populated by `pac code init`; not needed in mock mode.
VITE_DATAVERSE_URL=https://<org>.crm4.dynamics.com

# "mock"  — in-memory fixtures, no environment needed. Default.
# "power" — the @microsoft/power-apps SDK, under the signed-in user.
VITE_DATA_MODE=mock
