{
  "name": "vsbcloud-cross-app-tests",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-app regression testing: VSBCloud canvas apps vs. ProjectCosts-CodeApp. See ../TEST-STRATEGY.md.",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install",
    "capture-auth": "playwright test scripts/capture-auth.ts --headed --project=setup --workers=1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "tsx reporting/generate-report.ts",
    "promote-baseline": "tsx scripts/promote-baseline.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
