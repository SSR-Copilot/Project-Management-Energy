{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "power:run": "pac code run",
    "power:push": "pac code push",
    "check:labels": "node scripts/check-control-labels.mjs --warnings",
    "verify": "node scripts/check-power-sources.mjs && npm run typecheck && npm run lint && node scripts/check-control-labels.mjs && node scripts/check-canvas-identities.mjs && vitest run && npm run build",
    "check:canvas": "node scripts/check-canvas-identities.mjs",
    "check:power": "node scripts/check-power-sources.mjs",
    "e2e:auth:codeapp": "node e2e/auth.mjs codeapp",
    "e2e:auth:canvas": "node e2e/auth.mjs canvas",
    "e2e:codeapp": "playwright test --project=codeapp",
    "e2e:canvas": "playwright test --project=canvas",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-datepicker-compat": "^0.6.37",
    "@fluentui/react-icons": "^2.0.339",
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@microsoft/power-apps": "^1.3.1",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "react-spreadsheet": "^0.9.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
