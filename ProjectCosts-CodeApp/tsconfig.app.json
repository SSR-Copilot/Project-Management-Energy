{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    /* "DOM.Iterable" for the editor: TypeScript 6 (this project's) already has the NodeList / HTMLCollection
       iterators in "DOM", but VS Code's built-in TypeScript 5 does not, so `[...document.querySelectorAll(…)]`
       showed TS2488 in the editor only. In TS 6 the extra lib is an empty placeholder. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* `@/x` resolves to `src/x`. `baseUrl` is deprecated in TS 6, so the path is relative
       to this config file instead. The matching Vite alias is in `vite.config.ts`. */
    // D162: `fast-formula-parser` is aliased to the stub in vite.config.ts; the types follow the alias.
    "paths": { "@/*": ["./src/*"], "fast-formula-parser": ["./src/platform/formulaParserStub.ts"] },

    /* Linting. `strict` was NOT in the Vite scaffold; the canvas app leaned on Power Fx's
       Blank() coalescing everywhere, so every ported nullable needs the compiler's help. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", ".power"]
}
