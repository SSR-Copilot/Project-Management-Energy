{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* `@/x` resolves to `src/x`. `baseUrl` is deprecated in TS 6, so the path is relative
       to this config file instead. The matching Vite alias is in `vite.config.ts`. */
    "paths": { "@/*": ["./src/*"] },

    /* Linting. `strict` was NOT in the Vite scaffold; the canvas app leaned on Power Fx's
       Blank() coalescing everywhere, so every ported nullable needs the compiler's help. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", ".power"]
}
