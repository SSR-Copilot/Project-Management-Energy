id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.locIsVisiblePopUpSpinner"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.locIsVisiblePopUpSpinner"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'","member":"locIsVisiblePopUpSpinner"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.locSelectedCapexProjectContract"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.locSelectedCapexProjectContract"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'","member":"locSelectedCapexProjectContract"}}],"properties":{"level":"Medium"}},{"ruleId":"app-UnusedVariables","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.locSpinnerInformationText"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.locSpinnerInformationText"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'","member":"locSpinnerInformationText"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.OnVisible"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.OnVisible"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'","member":"OnVisible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.con_Contracts_Screen.con_Contracts_Body.con_Contracts_Content.con_Contracts_Content_CommandBar.cmd_Contracts_CommandBar.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.con_Contracts_Screen.con_Contracts_Body.con_Contracts_Content.con_Contracts_Content_CommandBar.cmd_Contracts_CommandBar.OnSelect"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'.con_Contracts_Screen.con_Contracts_Body.con_Contracts_Content.con_Contracts_Content_CommandBar.cmd_Contracts_CommandBar","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":11,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Contracts Screen'.con_Contracts_RightPanel_NewEdit.con_Contracts_RightPanel_NewEdit_Body.con_Contracts_RightPanel_NewEdit_Buttons.pcf_Contracts_RightPanel_NewEdit_Buttons_Save.OnChange"}},"logicalLocations":[{"fullyQualifiedName":"'Contracts Screen'.con_Contracts_RightPanel_NewEdit.con_Contracts_RightPanel_NewEdit_Body.con_Contracts_RightPanel_NewEdit_Buttons.pcf_Contracts_RightPanel_NewEdit_Buttons_Save.OnChange"}],"properties":{"module":"Contracts Screen","type":"'Contracts Screen'.con_Contracts_RightPanel_NewEdit.con_Contracts_RightPanel_NewEdit_Body.con_Contracts_RightPanel_NewEdit_Buttons.pcf_Contracts_RightPanel_NewEdit_Buttons_Save","member":"OnChange"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-WarnInvalidTypeForVariableDefinition","messageStrings":{"issue":{"text":"The variable {0} needs to have a non-Blank type. If this is the only place that {0} is defined, resolve this by adding another definition elsewhere that assigns a non-Blank value to this variable."}},"properties":{"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint-OpNotSupportedByColumn","messageStrings":{"issue":{"text":"Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-ReadableScreenNameNeeded","messageStrings":{"issue":{"text":"Revise screen name"}},"properties":{"howToFix":["Give the screen  a title that describes what's on the screen or what it's used for."],"whyFix":"People who are blind, have low vision, or a reading disability rely on screen titles to navigate using the screen reader. ","level":"Low","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-UnusedVariables","messageStrings":{"issue":{"text":"Unused variable"}},"properties":{"howToFix":["Remove the unused variable."],"whyFix":"This variable is declared but is not referenced by any control, so it is not needed.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-UnusedMediaResources","messageStrings":{"issue":{"text":"Unused media files"}},"properties":{"howToFix":["Remove the unused media file in the Media pane."],"whyFix":"This media file is not referenced by any control formulas so it is not needed. Removing it will improve performance.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectDelegatableDataSource","messageStrings":{"issue":{"text":"The rows retrieved from the data source may not be complete."}},"properties":{"howToFix":["Limit the data collected from the data source by updating the formula \"ClearCollect(colCapexAllAccountsTemporary, 'CAPEX Account Lists')\" to include a filtering function, such as 'Filter' or 'Search'."],"whyFix":"Using the 'Collect' function to create a collection directly from a connected data source may not load every row if the data source is too large.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-DataSourceDefaultMaxRowsLimit","messageStrings":{"issue":{"text":"Data row limit for non-delegable queries is more than 500"}},"properties":{"howToFix":["Update 'Data row limit for non-delegable queries' in the advanced app settings."],"whyFix":"A 'data row limit' more than 500 may result in a slower app when running non-delegable queries, because the app will have to process every row itself, rather than running the query on the server.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Mutating a collection or data source inside ForAll may trigger excessive rule re-evaluation"}},"properties":{"howToFix":["Since ForAll returns a table, pass its result as input to the mutation function in a single batched call. For example, replace ForAll(source, Collect(c, { ... })) with Collect(c, ForAll(source, { ... })); the same pattern applies to Patch and Remove. A single batched mutation emits one change notification instead of one per iteration.","For trivial per-row updates or deletions against a data source, prefer the delegable UpdateIf or RemoveIf functions called once outside ForAll instead of iterating with ForAll."],"whyFix":"Using Collect, Patch, Remove, or another mutation function inside the body of ForAll mutates the target collection or data source once per iteration. Every control property that depends on that collection or data source re-evaluates on each mutation, which can turn a small loop into thousands of rule evaluations and, for connected data sources, a network request per row.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Collection is initialized but never updated"}},"properties":{"howToFix":["Replace the Collect or ClearCollect with a named formula on App.Formulas. For example, MyTable = Filter(source, condition). Named formulas are computed when their inputs change and do not carry the tracking cost of a collection."],"whyFix":"Collections are meant to be updated. Power Apps does extra work to keep track of every collection so that anything depending on it stays in sync when the data changes. When the data never changes after it is set, that tracking work is wasted. A named formula gives the same data without the extra cost.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ScreenHasManyControls","messageStrings":{"issue":{"text":"Too many controls on a screen"}},"properties":{"howToFix":["Reduce the number of controls on the screen.","Break the app into more screens to reduce the per-screen complexity.","Use components to unify grouped controls that are identical across screens, reducing duplication.","Use galleries to represent a series of repeated similar controls.","Break the app into multiple apps so that each app is small and performant."],"whyFix":"Each control consumes resources, and an app may become slow or unresponsive if a screen has too many controls. The estimated complexity of \"Capex Costs Screen\" is 1328, which exceeds the maximum threshold recommended (300).","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CountRowsGalleryAllItems","messageStrings":{"issue":{"text":"Use AllItemsCount instead of CountRows with AllItems"}},"properties":{"howToFix":["Replace CountRows(Gallery.AllItems) with Gallery.AllItemsCount for better performance."],"whyFix":"Using CountRows with a gallery's AllItems property forces the creation of an output table containing a copy of the input data source and the current state of all child controls. This may force uninitialized rows to be initialized, consuming additional CPU cycles, memory, and potentially triggering row-level network requests.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-InefficientDelayLoading","messageStrings":{"issue":{"text":"Inefficient delay loading"}},"properties":{"howToFix":["Use variables, collections, and navigation context to share state across screens instead."],"whyFix":"Controls that reference controls on other screens can slow down app loading and navigation. Doing this may force the app to load the other screens immediately, rather than waiting until the user navigates to that screen.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}