    "Rules": [
      {
        "Property": "IsInteger_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsInteger",
        "Category": "Data",
        "InvariantScript": "And(\n    IsNumeric(candidate),\n    Not(\n        IsMatch(\n            candidate,\n            \"[.,]\",\n            MatchOptions.Contains\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange_min",
        "Category": "Data",
        "InvariantScript": "100",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange_max",
        "Category": "Data",
        "InvariantScript": "100",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange",
        "Category": "Data",
        "InvariantScript": "And(\n    IsNumeric(candidate),\n    And(\n        Value(candidate) >= min,\n        Value(candidate) <= max\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsOneDecimal",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\.\\d{0,1})?)\"\n        ),\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\,\\d{0,1})?)\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsOneDecimal_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsTwoDecimal_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsTwoDecimal",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^((\\+|-?)?\\d+(|\\.\\d{0,2})?)\"\n        ),\n        IsMatch(\n            candidate,\n            \"^((\\+|-?)?\\d+(|\\,\\d{0,2})?)\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsThreeDecimal_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsThreeDecimal",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\.\\d{0,3})?)\"\n        ),\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\,\\d{0,3})?)\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsNumberOrBlank",
        "Category": "Data",
        "InvariantScript": "With(\n    {varInput: Trim(candidate)},\n    If(\n        IsNumeric(varInput),\n        Round(\n            Value(varInput),\n            2\n        ),\n        Blank()\n    )\n)",
        "RuleProviderType": "System"
      },
      {
