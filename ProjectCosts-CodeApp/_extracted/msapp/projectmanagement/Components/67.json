    "Rules": [
      {
        "Property": "IsValidCurrency_candidate",
        "Category": "Data",
        "InvariantScript": "\"Text\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsValidCurrency",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\.\\d{0,2})?)\"\n        ),\n        IsMatch(\n            candidate,\n            \"^((\\+?)?\\d+(|\\,\\d{0,2})?)\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYears_candidate",
        "Category": "Data",
        "InvariantScript": "Now()",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYears_addition",
        "Category": "Data",
        "InvariantScript": "0.25",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYears",
        "Category": "Data",
        "InvariantScript": "DateAdd(\r\n    candidate,\r\n    Trunc(addition * 12 * 30),\r\n    TimeUnit.Days\r\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "ChecklisAsHTMLTable",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        tableStyle: \"style='border: 1px solid #dededf; height: 100%; width: 100%; table-layout: fixed; border-collapse: collapse; border-spacing: 1px; text-align: left;'\",\n        tableHeader: \"<thead>\n                <tr>\n                    <th style='font-size: 12px; width: 10%; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>Gate Relevance</th>\n                    <th style='font-size: 12px; width: 40%; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>Description</th>\n                    <th style='font-size: 12px; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>Cluster</th>\n                    <th style='font-size: 12px; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>State</th>\n                    <th style='font-size: 12px; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>Modified By</th>\n                    <th style='font-size: 12px; border: 1px solid #dededf;background-color: #eceff1; color: #000000;padding: 2px;'>Modified On</th>\n                </tr>\n            </thead>\",\n        rowStyle: \"style='font-size: 11px; border: 1px solid #dededf; background-color: #ffffff; color: #000000; padding: 2px; text-wrap:nowrap;'\"\n    },\n    $\"<table {tableStyle}>{tableHeader}<tbody>{Concat(\n        source,\n        $\"<tr><td {rowStyle}>{relevance}</td><td {rowStyle}>{name}</td><td {rowStyle}>{clusterstate}</td><td {rowStyle}>{taskstate}</td><td {rowStyle}>{editor}</td><td {rowStyle}>{Text(\n            editdate,\n            gblAppConstants.DateTime.DefaultFormat\n        )}</td></tr>\"\n    )}</tbody></table>\"\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "ChecklisAsHTMLTable_source",
        "Category": "Data",
        "InvariantScript": "Table(\n    {\n        name: \"Name\",\n        relevance: \"Gate Relevance\",\n        taskstate: \"Task State\",\n        index: 0,\n        clusterstate: \"Cluster State\",\n        editor: \"Modified By\",\n        editdate: Today()\n    }\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYearsRevamped_candidate",
        "Category": "Data",
        "InvariantScript": "DateTime(2000, 1, 1, 0, 0, 0)",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYearsRevamped_addition",
        "Category": "Data",
        "InvariantScript": "100",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddYearsRevamped",
        "Category": "Data",
        "InvariantScript": "With(\r\n    {\r\n        startDate: candidate,\r\n        yearsToAdd: Value(addition),\r\n        wholeYears: RoundDown(\r\n            Value(addition),\r\n            0\r\n        ),\r\n        fractionalYears: Value(addition) - RoundDown(\r\n            Value(addition),\r\n            0\r\n        )\r\n    },\r\n    With(\r\n        {\r\n            monthsToAdd: RoundDown(\r\n                fractionalYears * 12,\r\n                0\r\n            ),\r\n            remainingFraction: (fractionalYears * 12) - RoundDown(\r\n                fractionalYears * 12,\r\n                0\r\n            )\r\n        },\r\n        With(\r\n            {\r\n                dateAfterYearsAndMonths: DateAdd(\r\n                    DateAdd(\r\n                        candidate,\r\n                        wholeYears,\r\n                        TimeUnit.Years\r\n                    ),\r\n                    monthsToAdd,\r\n                    TimeUnit.Months\r\n                )\r\n            },\r\n            With(\r\n                {\r\n                    daysInMonth: Day(\r\n                        DateAdd(\r\n                            DateAdd(\r\n                                dateAfterYearsAndMonths,\r\n                                1,\r\n                                TimeUnit.Months\r\n                            ),\r\n                            -1,\r\n                            TimeUnit.Days\r\n                        )\r\n                    )\r\n                },\r\n                With(\r\n                    {\r\n                        daysToAdd: Round(\r\n                            remainingFraction * daysInMonth,\r\n                            0\r\n                        )\r\n                    },\r\n                    DateAdd(\r\n                        dateAfterYearsAndMonths,\r\n                        daysToAdd,\r\n                        TimeUnit.Days\r\n                    )\r\n                )\r\n            )\r\n        )\r\n    )\r\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddMonths_candidate",
        "Category": "Data",
        "InvariantScript": "DateTime(2000, 1, 1, 0, 0, 0)",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddMonths_addition",
        "Category": "Data",
        "InvariantScript": "100",
        "RuleProviderType": "System"
      },
      {
        "Property": "DateAddMonths",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        startDate: candidate,\n        monthsToAdd: Value(addition)\n    },\n    DateAdd(\n        candidate,\n        monthsToAdd,\n        TimeUnit.Months\n    )\n)",
        "RuleProviderType": "System"
      },
