      },
      {
        "Property": "IsTwoDecimal",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^[+-]?\\d+(?:\\.\\d{0,2})?$\"\n        ),\n        IsMatch(\n            candidate,\n            \"^[+-]?\\d+(?:\\,\\d{0,2})?$\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
