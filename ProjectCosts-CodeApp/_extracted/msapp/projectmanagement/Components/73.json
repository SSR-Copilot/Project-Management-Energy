        "InvariantScript": "100",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange",
        "Category": "Data",
        "InvariantScript": "And(\n    IsNumeric(candidate),\n    And(\n        Value(candidate) >= min,\n        Value(candidate) <= max\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsOneDecimal",
        "Category": "Data",
        "InvariantScript": "With(\n    {\n        varLang: Lower(\n            First(\n                Split(\n                    Language(),\n                    \"-\"\n                )\n            ).Value\n        )\n    },\n    Switch(\n        varLang,\n        \"en\",\n        IsMatch(\n            candidate,\n            \"^[+-]?\\d+(?:\\.\\d{0,1})?$\"\n        ),\n        IsMatch(\n            candidate,\n            \"^[+-]?\\d+(?:\\,\\d{0,1})?$\"\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
