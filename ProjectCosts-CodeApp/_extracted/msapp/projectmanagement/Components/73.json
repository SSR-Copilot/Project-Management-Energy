      {
        "Property": "IsInteger_candidate",
        "Category": "Data",
        "InvariantScript": "\"125\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "IsInteger",
        "Category": "Data",
        "InvariantScript": "And(\n    IsNumeric(candidate),\n    Not(\n        IsMatch(\n            candidate,\n            \"[.,]\",\n            MatchOptions.Contains\n        )\n    )\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange_candidate",
        "Category": "Data",
        "InvariantScript": "\"125\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "InRange_min",
