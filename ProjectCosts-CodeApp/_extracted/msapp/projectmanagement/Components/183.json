        "RuleProviderType": "System"
      },
      {
        "Property": "p75",
        "Category": "Data",
        "InvariantScript": "If(\n    And(\n        IsNumeric(p50),\n        IsNumeric(Uncertainty)\n    ),\n    Round(\n        Value(p50) + (-0.674490 * (Value(p50) * Value(Uncertainty))),\n        0\n    ),\n    -1\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "p90_p50",
        "Category": "Data",
        "InvariantScript": "\"0\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "p90_Uncertainty",
        "Category": "Data",
        "InvariantScript": "\"0\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "p90",
        "Category": "Data",
        "InvariantScript": "If(\n    And(\n        IsNumeric(p50),\n        IsNumeric(Uncertainty)\n    ),\n    Round(\n        Value(p50) + (-1.281551 * (Value(p50) * Value(Uncertainty))),\n        0\n    ),\n    -1\n)",
        "RuleProviderType": "System"
      },
      {
        "Property": "calculateUncertainty_p50",
        "Category": "Data",
        "InvariantScript": "\"1000\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "calculateUncertainty_p90",
        "Category": "Data",
        "InvariantScript": "\"500\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "calculateUncertainty_p75",
        "Category": "Data",
        "InvariantScript": "\"600\"",
        "RuleProviderType": "System"
      },
      {
        "Property": "calculateUncertainty",
        "Category": "Data",
        "InvariantScript": "If(\n    Not(IsBlank(p75)),\n    Round(\n        (Value(p50) - Value(p75) / Value(p50)*Value(0.674490)),\n        1\n    ),\n    Not(IsBlank(p90)),\n    Round(\n        (Value(p50) - Value(p90) / Value(p50)*Value(1.281551)),\n        1\n    )\n)",
        "RuleProviderType": "System"
      },
